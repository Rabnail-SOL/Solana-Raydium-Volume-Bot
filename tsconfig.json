{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["*.ts", "constants/**/*.ts", "executor/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
